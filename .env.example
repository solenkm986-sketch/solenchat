# Скопируйте этот файл в .env.local и заполните значениями из вашего
# проекта Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Понадобится начиная с этапа с админ-панелью / серверными операциями.
# НИКОГДА не добавляйте префикс NEXT_PUBLIC_ к этому ключу и не коммитьте его.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
